{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minitel",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "build": {
    "command": "npx @opennextjs/cloudflare build"
  },
  "observability": {
    "enabled": true
  }
}
